{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "^/css/(.*)$", "dest": "/HangHoanApp/css/$1" },
    { "src": "^/js/(.*)$", "dest": "/HangHoanApp/js/$1" },
    { "src": "^/vendor/(.*)$", "dest": "/HangHoanApp/vendor/$1" },
    { "src": "^/icon\\.svg$", "dest": "/HangHoanApp/icon.svg" },
    { "src": "^/manifest\\.webmanifest$", "dest": "/HangHoanApp/manifest.webmanifest" },
    { "src": "^/HangHoanApp/?$", "dest": "/HangHoanApp/index.html" },
    { "src": "^/HangHoanApp/(.*)$", "dest": "/HangHoanApp/$1" },
    { "src": "^/$", "dest": "/HangHoanApp/index.html" }
  ]
}
